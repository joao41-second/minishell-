void	start_shell(t_minis mini)
{
	getcwd(mini.path, PATH_MAX);
	mini.exit_code_error = 0;
	set_error_env(&mini);
	while (1)
	{
		get_signal(1);
		start_prompt_and_sig(&mini);
		if (!is_allspace(mini.line))
			excute_comand(&mini);
		set_error_env(&mini);
		getcwd(mini.path, PATH_MAX);
		mini.line = NULL;
	}
	free_list(mini.env, free_env);
	free_list(mini.env_org, free_env);
}
