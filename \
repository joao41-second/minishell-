#include "../minishell.h"
#include <stdio.h>

int	get_signal(int sig)
{
	static int	signals;

	if (sig != 0)
	{
		signals = sig;
	}
	return (signals);
}

static void	new_line(int sig, siginfo_t *info, void *ucontext)
{
	(void)info;
	(void)ucontext;
	get_signal(sig + 128);
	if (sig == SIGINT)
	{
		ft_printf("\n");
		rl_replace_line("", 0);
		rl_on_new_line();
		rl_redisplay();
	}
}

void	server(void)
{
	struct sigaction	sa;

	sigemptyset(&sa.sa_mask);
	sa.sa_sigaction = new_line;
	sa.sa_flags = SA_RESTART;
	sigaction(SIGINT, &sa, NULL);
	sigaction(SIGQUIT, &sa, NULL);
	signal(SIGTSTP, SIG_IGN);
}
